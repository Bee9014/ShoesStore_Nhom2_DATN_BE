<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fpl.edu.shoeStore.product.mapper.StockHistoryMapper">

    <resultMap id="StockHistoryResultMap" type="com.fpl.edu.shoeStore.product.entity.StockHistory">
        <id property="historyId" column="history_id" />
        <result property="variantId" column="variant_id" />
        <result property="amount" column="amount" />
        <result property="stockBefore" column="stock_before" />
        <result property="stockAfter" column="stock_after" />
        <result property="note" column="note" />
        <result property="createBy" column="create_by" />
        <result property="createAt" column="create_at" />
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="historyId">
        INSERT INTO stock_history (variant_id, amount, stock_before, stock_after, note, create_by, create_at)
        VALUES (#{variantId}, #{amount}, #{stockBefore}, #{stockAfter}, #{note}, #{createBy}, GETDATE())
    </insert>

    <select id="findByVariantId" resultType="com.fpl.edu.shoeStore.product.entity.StockHistory">
        SELECT * FROM stock_history WHERE variant_id = #{variantId} ORDER BY create_at DESC
    </select>
</mapper>